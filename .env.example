# SMTP settings (Gmail: smtp.gmail.com / 587 with an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USER=your.account@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=Sales ERP <your.account@gmail.com>

# Where new-order alerts are sent (comma-separated). Falls back to admin user emails if empty.
ADMIN_NOTIFY_EMAIL=

# Set to false to log emails without sending (useful for local development)
EMAIL_ENABLED=true

# Auth cookie signing key - change to a long random string
AUTH_COOKIE_KEY=change-me-to-a-long-random-string
AUTH_COOKIE_NAME=sales_erp_auth
AUTH_COOKIE_EXPIRY_DAYS=1

DATABASE_URL=sqlite:///data/sales_erp.db
COMPANY_NAME=Krypton Industries Limited
COMPANY_STATE=West Bengal
